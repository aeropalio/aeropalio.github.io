---
// src/pages/musica.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

// Troque pelos IDs reais dos vídeos (a parte após "v=" na URL do YouTube)
const paladarfilhoId = '5AJz7i9XfV4?si=-ndMwTF1-gOmlCUF';
const showPortaMalditaId = '';           // (para quando lançar)

---

<BaseLayout title="Música">
  <section class="hero">
    <p class="hero-label">Primeiro single</p>
    <h1 class="hero-title">AMPULHETA</h1>
    <span class="rupture"></span>
    <p class="hero-text">
      O primeiro single da AEROPALIO está sendo gravado.
      Demonstre seu interesse e seja avisado assim que sair.
    </p>
    <form action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="e4bd996a-80fb-4ce0-8847-d5d85b2c47a0">
      <input type="email" name="email" placeholder="seuemail@exemplo.com" required />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />
      <button type="submit">Receber atualizações</button>
    </form>
    <script>
      const form = document.getElementById("form") as HTMLFormElement;
      const result = document.getElementById("result") as HTMLElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        result.innerHTML = "Sending...";

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          result.innerHTML = "Form Submitted Successfully";
          form.reset();
        } else {
          result.innerHTML = data.message;
        }
      });
    </script>
  </section>

  <section class="section">
    <h2 class="section-title">Ao Vivo</h2>
    <p class="section-sub">Duas músicas gravadas ao vivo</p>
    <VideoEmbed videoId={paladarfilhoId} />
  </section>

  <section class="section section-alt">
    <h2 class="section-title">Show Completo</h2>
    <p class="section-sub">Em breve — a apresentação inteira, gravada ao vivo.</p>
  </section>

  <section class="section">
    <h2 class="section-title">Álbum de Estreia</h2>
    <p class="section-sub">Em produção — o primeiro álbum da AEROPALIO.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 5rem 1.5rem 4rem;
    background: var(--bg-alt);
    border-bottom: 1px solid rgba(245, 197, 24, 0.15);
  }
  .hero-label {
    text-transform: uppercase; letter-spacing: 0.3em;
    font-size: 0.8rem; color: var(--accent); margin: 0 0 0.5rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: 0.08em; color: var(--text); margin: 0;
  }
  .hero-text { color: var(--text-muted); max-width: 480px; margin: 0 auto 2rem; }
  .interest { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .interest input { min-width: 280px; }
</style>