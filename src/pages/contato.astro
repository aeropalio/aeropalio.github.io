---
// src/pages/contato.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// Use os mesmos links reais que você colocou no Footer
const socials = [
  { href: 'https://youtube.com/@AEROPALIO', label: 'YouTube' },
  { href: 'https://instagram.com/aeropaliopalio', label: 'Instagram' },
  { href: 'mailto:contato@aeropalio.com.br', label: 'E-mail' },
];
---

<BaseLayout
  title="Contato"
  description="AEROPALIO — Contato, booking e redes sociais."
>
  <!-- Booking -->
  <section class="hero">
    <h1 class="hero-title">Fale com a AEROPALIO</h1>
    <p class="hero-text">
      Quer contratar a banda para um show ou divulgar um lançamento?
      Escreva para a gente.
    </p>
    <a href="mailto:contato@aeropalio.com.br" class="btn">Enviar e-mail</a>
  </section>

  <!-- Redes -->
  <section class="section">
    <h2 class="section-title">Redes Sociais</h2>
    <ul class="socials">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Formulário -->
  <section class="section section-alt">
    <h2 class="section-title">Mensagem</h2>
    <form action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="e4bd996a-80fb-4ce0-8847-d5d85b2c47a0">
      <input type="text" name="nome" placeholder="Seu nome" required />
      <input type="email" name="email" placeholder="seuemail@exemplo.com" required />
      <textarea name="mensagem" placeholder="Sua mensagem" rows="5" required></textarea>
      <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />
      <button type="submit">Enviar mensagem</button>
    </form>
    <script>
      const form = document.getElementById("form") as HTMLFormElement;
      const result = document.getElementById("result") as HTMLElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        result.innerHTML = "Sending...";

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          result.innerHTML = "Form Submitted Successfully";
          form.reset();
        } else {
          result.innerHTML = data.message;
        }
      });
    </script>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center; padding: 5rem 1.5rem 4rem;
    background: var(--bg-alt);
    border-bottom: 1px solid rgba(245, 197, 24, 0.15);
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--text); margin: 0 0 1.5rem;
  }
  .hero-text { color: var(--text-muted); max-width: 480px; margin: 0 auto 2rem; line-height: 1.7; }
  .socials { list-style: none; display: flex; justify-content: center; gap: 2rem; margin: 0; padding: 0; }
  .socials a { color: var(--text-muted); text-decoration: none; font-size: 1rem; transition: color 0.2s; }
  .socials a:hover { color: var(--accent); }
  .contact { display: flex; flex-direction: column; gap: 0.75rem; max-width: 480px; margin: 0 auto; }
  .contact textarea { resize: vertical; }
</style>