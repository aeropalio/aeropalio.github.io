---
// src/pages/sobre.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// Troque pelos nomes e papéis reais dos integrantes
const integrantes = [
  { nome: '', papel: '' },
  { nome: '', papel: '' },
  { nome: '', papel: '' },
  { nome: '', papel: '' },
];
---

<BaseLayout
  title="Sobre"
  description="AEROPALIO — roque alternativo todo autoral. Conheça a história da banda."
>
  <!-- História -->
  <section class="hero">
    <h1 class="hero-title">Sobre a AEROPALIO</h1>
    <p class="hero-text">
      piriripiriripiriri popopopopopopo
    </p>
  </section>

  <!-- Integrantes -->
  <section class="section">
    <h2 class="section-title">Integrantes</h2>
    <div class="grid">
      {integrantes.map((m) => (
        <article class="card">
          <h3 class="card-name">{m.nome}</h3>
          <p class="card-role">{m.papel}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Fotos -->
  <section class="section section-alt">
    <h2 class="section-title">Fotos</h2>
    <p class="section-sub">Em breve — registros ao vivo e de estúdio.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center; padding: 5rem 1.5rem 4rem;
    background: var(--bg-alt);
    border-bottom: 1px solid rgba(245, 197, 24, 0.15);
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--text); margin: 0 0 1.5rem;
  }
  .hero-text { color: var(--text-muted); max-width: 640px; margin: 0 auto; line-height: 1.7; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .card {
    background: var(--bg-alt);
    border: 1px solid rgba(245, 197, 24, 0.15);
    border-radius: 4px;
    padding: 1.5rem 1rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .card-name {
    font-family: var(--font-serif); color: var(--text);
    margin: 0 0 0.25rem; font-size: 1.2rem;
  }
  .card-role {
    color: var(--accent); font-size: 0.85rem;
    text-transform: uppercase; letter-spacing: 0.1em; margin: 0;
  }
</style>